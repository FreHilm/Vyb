{
  "name": "agentdispatch",
  "productName": "AgentDispatch",
  "version": "1.0.0",
  "description": "Manage multiple AI agent terminal sessions in one place",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"const{execSync}=require('child_process');const path=require('path');const fs=require('fs');const eBase=path.join(require('electron'),'../../..');const p=path.join(eBase,'Contents','Info.plist');try{execSync('/usr/libexec/PlistBuddy -c \\'Set :CFBundleName AgentDispatch\\' \\''+p+'\\'');execSync('/usr/libexec/PlistBuddy -c \\'Set :CFBundleDisplayName AgentDispatch\\' \\''+p+'\\'');}catch(e){}const src=path.join(__dirname,'build','icon.icns');const dst=path.join(eBase,'Contents','Resources','electron.icns');if(fs.existsSync(src))fs.copyFileSync(src,dst);\"",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "Fredrik Hilmersson",
    "email": "fredrik@hawco.se"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "41.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "terser": "^5.46.1",
    "typescript": "~5.8.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@frehilm/ordna-core": "^0.1.0",
    "@frehilm/ordna-web": "^0.1.0",
    "@types/archiver": "^7.0.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "codemirror": "^6.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "tar": "^7.5.11",
    "tmp": "^0.2.4"
  }
}
